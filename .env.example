# Copied into real env vars by `nix develop`'s shellHook for local dev.
# This file documents what's configurable; it is not auto-loaded.

DATABASE_URL=postgresql+psycopg://membase@/membase?host=.data/postgres-socket&port=5544
# Path to a plaintext file containing the one shared login password
# (just the password, nothing else -- see docs/DECISIONS.md "Password
# login with per-device tokens"). Read fresh on every login attempt,
# so you can change it by editing the file in place (e.g. over SSH)
# with no restart. `nix develop` seeds a dev-only default under
# .data/ if the file doesn't exist yet -- before deploying anywhere
# reachable off your own machine, point this at a real file (chmod
# 600, owned by whichever user runs the app) with a real password in it.
MEMBASE_AUTH_PASSWORD_FILE=.data/auth_password
OLLAMA_HOST=http://127.0.0.1:11434
MEMBASE_GENERATION_MODEL=gemma4:12b
MEMBASE_EMBED_MODEL=nomic-embed-text
MEMBASE_EMBED_DIM=768
UPLOADS_DIR=.data/uploads
MEMBASE_MAX_UPLOAD_MB=50
