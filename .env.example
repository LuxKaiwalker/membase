# Copied into real env vars by `nix develop`'s shellHook for local dev.
# This file documents what's configurable; it is not auto-loaded.

DATABASE_URL=postgresql+psycopg://membase@/membase?host=.data/postgres-socket&port=5544
# The one origin allowed to make cross-origin requests to this API --
# the published GitHub Pages frontend's origin in production (e.g.
# https://luxkaiwalker.github.io). Authentication is handled by the
# nginx reverse proxy in front of this app (HTTP Basic Auth), not by
# this app itself -- see docs/DECISIONS.md "Retire app-level auth for
# nginx Basic Auth". Defaults to same-origin local dev.
FRONTEND_ORIGIN=http://127.0.0.1:8000
OLLAMA_HOST=http://127.0.0.1:11434
MEMBASE_GENERATION_MODEL=gemma4:12b
MEMBASE_EMBED_MODEL=nomic-embed-text
MEMBASE_EMBED_DIM=768
UPLOADS_DIR=.data/uploads
MEMBASE_MAX_UPLOAD_MB=50
